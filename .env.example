# Documentation only; the application reads environment variables, not this file.
CONTEXTPILOT_API_URL=http://127.0.0.1:8765
CONTEXTPILOT_DB=var/assistant.sqlite3
CONTEXTPILOT_TRACE=var/traces.jsonl
AVALAI_API_KEY=
# Optional absolute path when the supplied MCP server is elsewhere:
# CONTEXTPILOT_MCP_SERVER=/absolute/path/to/mcp_server.py
# Optional, demo/evaluation only: pin the policy clock (YYYY-MM-DD). Unset = current UTC date.
# CONTEXTPILOT_TODAY=2026-11-16
CONTEXTPILOT_MODEL_MODE=deterministic
# For live rendering, set CONTEXTPILOT_MODEL_MODE=avalai and supply AVALAI_API_KEY
# through the Git-ignored .env or process environment.
# The adapter uses https://api.avalai.ir/v1 and deepseek-v4.1-flash.
